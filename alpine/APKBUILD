# Contributor: Jos Dehaes <jos.dehaes@gmail.com>
# Maintainer: Jos Dehaes <jos.dehaes@gmail.com>
pkgname=yserver
pkgver=1.4.0
pkgrel=0
pkgdesc="A modern X11 server written from scratch in Rust (DRM/KMS + Vulkan)"
url="https://github.com/joske/yserver"
# Needs atomic KMS/DRM and a Vulkan driver. Only these two are tested
# upstream, so the arch list stays narrow rather than optimistic.
arch="x86_64 aarch64"
license="MIT"
# Runtime dependencies that nothing can infer from the ELF headers:
#   vulkan-loader     — ash dlopen()s libvulkan.so.1
#   xauth, mcookie    — starty(1) execs both and refuses to start without
#                       either. NOT util-linux: Alpine splits it, and the
#                       package that actually provides cmd:mcookie is the
#                       standalone `mcookie` (main).
#   xkeyboard-config  — xkbcommon reads the rules/keymaps at runtime
# A Vulkan ICD (mesa-vulkan-ati, mesa-vulkan-intel, …) is also required for
# rendering, but which one is hardware-dependent, so it is not pinned here.
depends="vulkan-loader xauth mcookie xkeyboard-config"
makedepends="
	cargo
	just
	scdoc
	shaderc
	gcc
	musl-dev
	pkgconf
	libxshmfence-dev
	libxkbcommon-dev
	libinput-dev
	fontconfig-dev
	freetype-dev
	mesa-dev
	eudev-dev
	"
# Alpine policy splits documentation and man pages out of the main package;
# default_doc picks up /usr/share/doc and /usr/share/man.
subpackages="$pkgname-doc"
# GitHub's auto-generated tag archive. The release no longer ships a separate
# source tarball: it duplicated this one (same tree, different bytes) and left
# two source downloads on the release page, one of which did not match the
# published checksums.
#
# Caveat accepted knowingly: these archives are generated on demand, and
# GitHub changed their compression once in 2023, which invalidated pinned
# checksums across the AUR and elsewhere. They reverted and now treat it as
# breaking, but there is no formal guarantee. If it ever happens again, bump
# pkgrel and re-run `abuild checksum`.
source="$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"

# The test suite has not been validated in a hardware-less builder, so it is
# not run here rather than being wired up on the assumption that it passes.
options="!check"

# yserver links several C libraries, so a fully static binary is not viable.
export RUSTFLAGS="${RUSTFLAGS:-} -C target-feature=-crt-static"

build() {
	# A release tarball has no .git; without this the build script stamps
	# the literal string "unknown" into `yserver --version`.
	export YSERVER_GIT_COMMIT="v$pkgver"
	cargo build --locked --release --bin yserver
	PREFIX=/usr just man
}

package() {
	# TMPFILESDIR is deliberately empty: Alpine is not a systemd system, so
	# a tmpfiles.d snippet would never be read. That leaves /tmp/.X11-unix
	# to be created by whatever starts X — yserver creates it if missing,
	# but under the calling user's umask, so a shared multi-user machine
	# should create it root-owned and sticky (mode 1777) at boot instead.
	DESTDIR="$pkgdir" PREFIX=/usr TMPFILESDIR= just install

	# Alpine keeps licences under /usr/share/licenses/<pkg>; relocate the
	# generic copy that `just install` stages into /usr/share/doc/yserver.
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	rm -f "$pkgdir/usr/share/doc/$pkgname/LICENSE"
}

doc() {
	default_doc
	# abuild's default_doc sweeps /usr/share/licenses into -doc along with the
	# docs, which left 1.4.0's main apk with no licence file at all. COPY it
	# back rather than moving it: Alpine convention puts licences in -doc, and
	# installing yserver without yserver-doc should still carry one, so both
	# packages get it.
	#
	# This relies on abuild packaging the main apk after the subpackage split
	# functions run (package -> prepare_subpackages -> prepare_package ->
	# create_apks). The build workflow asserts the result rather than trusting
	# that ordering.
	if [ -d "$subpkgdir/usr/share/licenses" ]; then
		mkdir -p "$pkgdir/usr/share"
		cp -a "$subpkgdir/usr/share/licenses" "$pkgdir/usr/share/"
	fi
}

# Regenerate with `abuild checksum` on every pkgver bump.
sha512sums="
e419f320d37934dbbb8a71585f3d3840566beac7d145059097c18f68cd633eeabc487e0ab5a1e480ba1423b23e0f386733130352fc3213fe670bda58276372f2  yserver-1.4.0.tar.gz
"
